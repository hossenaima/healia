# Copy to .env and fill in. See README.md for what each one does.

# SQLite file. In production point this at a persistent volume, e.g. file:/data/healia.db
DATABASE_URL="file:./dev.db"

# Required in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Decides which calendar day an entry belongs to when the server runs in UTC.
APP_TIMEZONE="America/New_York"

# Optional. Without it, meal logging still works but calorie estimation is off.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
