# Copy to .env and fill in. See README.md for what each one does.

# Supabase → Connect → URI. Two strings, told apart by port.
# Port 6543 (transaction pooler) — used by the app at runtime.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Port 5432 (session pooler) — used only to run migrations.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Required in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Decides which calendar day an entry belongs to when the server runs in UTC.
APP_TIMEZONE="America/New_York"


# Set to "false" to close signup once everyone who needs an account has one.
ALLOW_SIGNUP="true"

# Google AI Studio key. Turns on calorie estimation and "What can I eat?".
# Without it the app still works and those buttons explain why they are off.
GEMINI_API_KEY=""
# Optional model override; defaults to gemini-2.5-flash.
GEMINI_MODEL=""
