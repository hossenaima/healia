# Copy to .env and fill in. See README.md for what each one does.

# Supabase → Connect → URI. Two strings, told apart by port.
# Port 6543 (transaction pooler) — used by the app at runtime.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Port 5432 (session pooler) — used only to run migrations.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Required in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Decides which calendar day an entry belongs to when the server runs in UTC.
APP_TIMEZONE="America/New_York"

# Optional. Without it, meal logging still works but calorie estimation is off.
# Get one at console.anthropic.com.
ANTHROPIC_API_KEY=""

# Set to "false" to close signup once everyone who needs an account has one.
ALLOW_SIGNUP="true"
