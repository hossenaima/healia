// Healia — personal health tracker
// Docs: https://pris.ly/d/prisma-schema
//
// Days are stored as plain "YYYY-MM-DD" strings rather than DateTime. A morning
// weigh-in belongs to a calendar day in the user's local timezone; storing it as
// a UTC instant makes entries jump days across DST and travel.
//
// Every row of health data hangs off a User. Accounts are fully isolated: no
// query in the app reads a WeightEntry or Meal without filtering on userId.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(cuid())

  /// Name as typed, used for display.
  name   String
  /// Lowercased `name`, used for lookup — so "Aima" and "aima" are one account.
  handle String @unique

  /// scrypt hash of this user's PIN.
  pinHash String
  pinSalt String

  /// Canonical storage is always pounds; `units` only controls display.
  goalWeightLbs  Float?
  startWeightLbs Float?
  heightInches   Float?
  units          String @default("lb") // "lb" | "kg"

  weightEntries WeightEntry[]
  meals         Meal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WeightEntry {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// "YYYY-MM-DD" local day. One weigh-in per person per day.
  date      String
  weightLbs Float
  note      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
}

model Meal {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// "YYYY-MM-DD" local day.
  date String
  /// Free text, e.g. "Breakfast", "Post-run snack". There is no fixed set of
  /// meals — a day holds as many as the user logs.
  name String @default("Meal")
  /// What the user typed, verbatim, before any AI parsing.
  note String @default("")

  items MealItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, date])
}

model MealItem {
  id       String  @id @default(cuid())
  mealId   String
  meal     Meal    @relation(fields: [mealId], references: [id], onDelete: Cascade)
  name     String
  /// Free text, e.g. "1 cup", "2 slices".
  quantity String?
  calories Int?
  proteinG Float?
  carbsG   Float?
  fatG     Float?
  /// "manual" | "ai" — lets the UI flag estimates the user has not confirmed.
  source   String  @default("manual")

  createdAt DateTime @default(now())

  @@index([mealId])
}
